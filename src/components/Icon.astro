---
// Ikon SVG inline. Ikon umum dari lucide-static, ikon brand dari simple-icons.
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;

const lucide: Record<string, string> = {
  calendar: 'calendar',
  pin: 'map-pin',
  globe: 'globe',
  code: 'code-xml',
  chart: 'chart-column-increasing',
  megaphone: 'megaphone',
  pen: 'pen-tool',
  arrow: 'arrow-right',
  rocket: 'rocket',
  mail: 'mail',
  up: 'arrow-up',
  menu: 'menu',
  close: 'x',
  download: 'download',
  leaf: 'leaf',
  external: 'external-link',
  zoom: 'zoom-in',
  prev: 'chevron-left',
  next: 'chevron-right',
  quote: 'quote',
};

const brands: Record<string, string> = {
  github: 'github',
  facebook: 'facebook',
  whatsapp: 'whatsapp',
  telegram: 'telegram',
  instagram: 'instagram',
  line: 'line',
  twitter: 'x',
};

const linkedin =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.6c0-1.34-.02-3.06-1.86-3.06-1.87 0-2.15 1.46-2.15 2.96V21H9z"/></svg>';

let svg = '';
const root = process.cwd();
if (name === 'linkedin') {
  svg = linkedin;
} else if (lucide[name]) {
  svg = fs.readFileSync(path.join(root, 'node_modules/lucide-static/icons', `${lucide[name]}.svg`), 'utf8');
} else if (brands[name]) {
  svg = fs
    .readFileSync(path.join(root, 'node_modules/simple-icons/icons', `${brands[name]}.svg`), 'utf8')
    .replace('<svg', '<svg fill="currentColor"');
}

// Bersihkan komentar & atribut ukuran bawaan, lalu pasang ukuran sendiri
// Hanya atribut pada tag <svg> pembuka yang diganti (bukan pada <rect> dll.)
svg = svg
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/<svg[^>]*>/, (tag) =>
    tag
      .replace(/\s(width|height|class)="[^"]*"/g, '')
      .replace('<svg', `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" class="icon ${className}"`),
  );
---

<Fragment set:html={svg} />
