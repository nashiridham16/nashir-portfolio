---
// Teks dua bahasa. Default tampil English; script di DevLayout menukar ke Indonesia.
interface Props {
  t: { en: string; id: string };
  as?: string;
  class?: string;
  [key: string]: unknown;
}
const { t, as = 'span', class: className, ...rest } = Astro.props;
const Tag = as as any;
---

<Tag class={className} data-t-en={t.en} data-t-id={t.id} set:html={t.en} {...rest} />
