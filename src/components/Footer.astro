---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p>Copyright © {year} Portofolio | Powered by {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--white);
    color: var(--navy);
    text-align: center;
    padding: 22px 0;
    font-size: 13px;
    font-weight: 500;
  }
</style>
