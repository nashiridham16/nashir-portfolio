---
import { site } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  before?: string;
  highlight: string;
  after?: string;
  image: string;
  imageAlt: string;
}

const { before = '', highlight, after = '', image, imageAlt } = Astro.props;
---

<section class="page-hero">
  <div class="container hero-grid">
    <div class="hero-text reveal">
      <h1>
        {before && <span>{before} </span>}
        <span class="text-green">{highlight}</span>
        {after && <span> {after}</span>}
      </h1>
      <p>Mengabadikan kreativitas dalam setiap karya dan menciptakan pengalaman visual yang tak terlupakan dalam setiap pixel.</p>
      <a href={site.whatsapp} class="btn" target="_blank" rel="noopener">
        Collabs With Me <Icon name="rocket" size={16} />
      </a>
    </div>
    <div class="hero-image reveal">
      <img src={image} alt={imageAlt} width="520" height="520" fetchpriority="high" />
    </div>
  </div>
</section>

<section class="fantastic">
  <div class="container">
    <p class="script">My Fantastic</p>
    <h2>Portofolio</h2>
    <hr />
  </div>
</section>

<style>
  .page-hero {
    padding: 40px 0 30px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 40px;
  }
  h1 {
    font-size: clamp(40px, 6.5vw, 75px);
    font-weight: 700;
    line-height: 1;
    text-shadow: 0 0 18px rgba(255, 255, 255, 0.2);
  }
  h1 .text-green {
    text-shadow: 0 0 22px rgba(157, 255, 32, 0.45);
  }
  .hero-text p {
    color: #c9c9c9;
    font-size: 13px;
    max-width: 440px;
    margin: 28px 0 32px;
  }
  .hero-image img {
    width: 100%;
    max-width: 440px;
    margin-left: auto;
  }
  .fantastic {
    text-align: center;
    padding: 50px 0 10px;
  }
  .script {
    font-family: var(--font-script);
    color: var(--green);
    font-size: 40px;
    line-height: 0.6;
  }
  .fantastic h2 {
    font-size: clamp(36px, 5vw, 50px);
  }
  .fantastic hr {
    border: 0;
    height: 2px;
    background: #3a3a3a;
    margin: 18px 0 0;
  }
  @media (max-width: 767px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 24px;
    }
    .hero-text p {
      margin: 20px auto 26px;
    }
    .hero-image {
      order: -1;
    }
    .hero-image img {
      max-width: 280px;
      margin: 0 auto;
    }
  }
</style>
