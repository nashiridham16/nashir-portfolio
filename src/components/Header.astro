---
import Icon from './Icon.astro';

interface Props {
  items: { label: string; href: string }[];
}

const { items } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  if (href.includes('#')) return false;
  const clean = href.replace(/\/+$/, '') || '/';
  return clean === path;
};
---

<header class="site-header" id="top">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Beranda">My Portofolio</a>

    <button class="menu-toggle" type="button" aria-label="Buka menu" aria-expanded="false" aria-controls="site-nav">
      <span class="i-open"><Icon name="menu" size={22} /></span>
      <span class="i-close"><Icon name="close" size={22} /></span>
    </button>

    <nav class="nav" id="site-nav" aria-label="Navigasi utama">
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('.nav');

  const close = () => {
    header?.classList.remove('menu-open');
    toggle?.setAttribute('aria-expanded', 'false');
  };

  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('menu-open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && close());

  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 20);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 18px 0;
    transition: background 0.3s ease, padding 0.3s ease;
  }
  .site-header.scrolled {
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 10px 0;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .logo {
    font-family: var(--font-script);
    font-size: 40px;
    line-height: 1;
    color: var(--green);
    white-space: nowrap;
  }
  .nav ul {
    display: flex;
    align-items: center;
    gap: 4px;
    background: var(--white);
    padding: 6px;
    border-radius: 999px;
    box-shadow: 0 0 28px rgba(255, 255, 255, 0.35);
  }
  .nav a {
    display: block;
    padding: 7px 18px;
    border-radius: 999px;
    color: var(--black);
    font-size: 13px;
    font-weight: 500;
    transition: background 0.2s ease;
  }
  .nav a:hover,
  .nav a.active {
    background: var(--green);
  }
  .menu-toggle {
    display: none;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 10px;
    background: var(--green);
    color: var(--black);
    cursor: pointer;
    place-items: center;
  }
  .menu-toggle .i-close {
    display: none;
  }
  .menu-open .menu-toggle .i-open {
    display: none;
  }
  .menu-open .menu-toggle .i-close {
    display: inline;
  }

  @media (max-width: 991px) {
    .logo {
      font-size: 34px;
    }
    .menu-toggle {
      display: grid;
    }
    .nav {
      position: absolute;
      top: 100%;
      left: 16px;
      right: 16px;
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .menu-open .nav {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    .nav ul {
      flex-direction: column;
      align-items: stretch;
      border-radius: 18px;
      padding: 10px;
    }
    .nav a {
      padding: 12px 18px;
      font-size: 15px;
      border-radius: 12px;
    }
  }
</style>
