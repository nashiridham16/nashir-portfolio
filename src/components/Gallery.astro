---
// Galeri masonry + lightbox (klik gambar untuk memperbesar)
import Icon from './Icon.astro';

interface Props {
  images: string[];
  columns?: 3 | 4;
  mobileColumns?: 1 | 2;
  label: string;
}

const { images, columns = 3, mobileColumns = 1, label } = Astro.props;
---

<section class="gallery-section">
  <div class="container">
    <div class="gallery" style={`--cols:${columns};--cols-mobile:${mobileColumns}`} data-gallery>
      {
        images.map((src, i) => (
          <button type="button" class="g-item" data-index={i} data-src={src} aria-label={`Lihat ${label} ${i + 1}`}>
            <img src={src} alt={`${label} ${i + 1}`} loading="lazy" decoding="async" />
            <span class="g-overlay">
              <Icon name="zoom" size={28} />
            </span>
          </button>
        ))
      }
    </div>
    <slot />
  </div>
</section>

<dialog class="lightbox" aria-label={`Galeri ${label}`}>
  <button type="button" class="lb-btn lb-close" aria-label="Tutup"><Icon name="close" size={24} /></button>
  <button type="button" class="lb-btn lb-prev" aria-label="Sebelumnya"><Icon name="prev" size={28} /></button>
  <img class="lb-img" src="" alt="" />
  <button type="button" class="lb-btn lb-next" aria-label="Berikutnya"><Icon name="next" size={28} /></button>
  <p class="lb-count"></p>
</dialog>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const dialog = gallery.closest('.gallery-section')?.nextElementSibling as HTMLDialogElement | null;
    if (!dialog) return;
    const img = dialog.querySelector<HTMLImageElement>('.lb-img')!;
    const count = dialog.querySelector<HTMLElement>('.lb-count')!;
    const items = [...gallery.querySelectorAll<HTMLButtonElement>('.g-item')];
    let current = 0;

    const show = (i: number) => {
      current = (i + items.length) % items.length;
      img.src = items[current].dataset.src!;
      img.alt = items[current].querySelector('img')?.alt ?? '';
      count.textContent = `${current + 1} / ${items.length}`;
    };

    items.forEach((btn, i) =>
      btn.addEventListener('click', () => {
        show(i);
        dialog.showModal();
        document.body.style.overflow = 'hidden';
      }),
    );
    dialog.addEventListener('close', () => (document.body.style.overflow = ''));
    dialog.querySelector('.lb-close')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lb-prev')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('.lb-next')?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // Geser (swipe) di HP
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });
  });
</script>

<style>
  .gallery-section {
    padding: 28px 0 90px;
  }
  .gallery {
    column-count: var(--cols);
    column-gap: 16px;
  }
  .g-item {
    position: relative;
    display: block;
    width: 100%;
    margin: 0 0 16px;
    padding: 0;
    border: 0;
    background: #111;
    border-radius: 8px;
    overflow: hidden;
    cursor: zoom-in;
    break-inside: avoid;
  }
  .g-item img {
    width: 100%;
    transition: transform 0.4s ease;
  }
  .g-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(0, 0, 0, 0.45);
    color: var(--green);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .g-item:hover img,
  .g-item:focus-visible img {
    transform: scale(1.05);
  }
  .g-item:hover .g-overlay,
  .g-item:focus-visible .g-overlay {
    opacity: 1;
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 56px 64px;
    border: 0;
    background: rgba(0, 0, 0, 0.94);
    color: #fff;
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.8);
  }
  .lb-img {
    max-width: 100%;
    max-height: calc(100dvh - 120px);
    object-fit: contain;
    border-radius: 6px;
  }
  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    cursor: pointer;
  }
  .lb-btn:hover {
    background: var(--green);
    color: #000;
  }
  .lb-close {
    top: 14px;
    right: 14px;
  }
  .lb-prev {
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-count {
    position: absolute;
    bottom: 16px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 13px;
    color: #bbb;
    pointer-events: none;
  }

  @media (max-width: 991px) {
    .gallery {
      column-count: 2;
    }
  }
  @media (max-width: 575px) {
    .gallery {
      column-count: var(--cols-mobile, 1);
      column-gap: 10px;
    }
    .g-item {
      margin-bottom: 10px;
    }
    .lightbox {
      padding: 60px 12px;
    }
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 6px;
      transform: none;
      z-index: 1;
    }
    .lb-count {
      bottom: 20px;
    }
  }
</style>
