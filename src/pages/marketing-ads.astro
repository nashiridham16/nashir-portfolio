---
import DevLayout from '../layouts/DevLayout.astro';
import PageHead from '../components/PageHead.astro';
import WorkTabs from '../components/WorkTabs.astro';
import DevGallery from '../components/DevGallery.astro';
import CtaBand from '../components/CtaBand.astro';
import L from '../components/L.astro';
import Icon from '../components/Icon.astro';
import { adsGallery, adsReportLink } from '../data/site';
import { adsPage, adsMore, galleryLabels } from '../data/pages';
---

<DevLayout title={adsPage.metaTitle} description={adsPage.metaDescription}>
  <PageHead page={adsPage}>
    <a slot="actions" href={adsReportLink} class="btn btn-ghost" target="_blank" rel="noopener">
      <Icon name="external" size={18} /> <L t={adsMore} />
    </a>
  </PageHead>
  <WorkTabs />
  <section class="wrap body">
    <DevGallery items={adsGallery} label={galleryLabels.ads} columns={3} />
    <div class="more">
      <a href={adsReportLink} class="btn btn-primary" target="_blank" rel="noopener">
        <Icon name="external" size={18} /> <L t={adsMore} />
      </a>
    </div>
  </section>
  <CtaBand />
</DevLayout>

<style>
  .body {
    padding-top: 28px;
  }
  .more {
    display: flex;
    justify-content: center;
    margin-top: 16px;
  }
</style>
