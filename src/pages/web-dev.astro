---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { webProjects } from '../data/site';
---

<BaseLayout title="Web Develop" description="Portofolio website yang dibuat Idham Ahmad Nashir: company profile, landing page, toko online, dan lainnya.">
  <PageHero before="Website" highlight="Developer" image="/images/illustration-web-dev.png" imageAlt="Ilustrasi web developer" />

  <section class="projects">
    <div class="container">
      <ul class="project-grid">
        {
          webProjects.map((p) => (
            <li class="project reveal">
              <div class="project-img">
                <img src={p.image} alt={`Tampilan website ${p.name}`} loading="lazy" decoding="async" width="988" height="568" />
              </div>
              <div class="project-body">
                <h2>{p.name}</h2>
                <p>{p.type}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .projects {
    padding: 28px 0 90px;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .project {
    background: var(--white);
    color: var(--navy);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .project:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(157, 255, 32, 0.22);
  }
  .project-img {
    background: #f4f4f4;
    aspect-ratio: 988 / 568;
    overflow: hidden;
  }
  .project-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .project:hover .project-img img {
    transform: scale(1.04);
  }
  .project-body {
    padding: 16px 20px 20px;
    border-top: 4px solid var(--green);
  }
  .project-body h2 {
    font-size: 17px;
  }
  .project-body p {
    font-size: 13px;
    color: var(--slate);
    margin-top: 2px;
  }
  @media (max-width: 991px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 575px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
