---
import DevLayout from '../layouts/DevLayout.astro';
import PageHead from '../components/PageHead.astro';
import WorkTabs from '../components/WorkTabs.astro';
import DevGallery from '../components/DevGallery.astro';
import CtaBand from '../components/CtaBand.astro';
import { seoGallery } from '../data/site';
import { seoPage, galleryLabels } from '../data/pages';
---

<DevLayout title={seoPage.metaTitle} description={seoPage.metaDescription}>
  <PageHead page={seoPage} />
  <WorkTabs />
  <section class="wrap body">
    <DevGallery items={seoGallery} label={galleryLabels.seo} columns={2} />
  </section>
  <CtaBand />
</DevLayout>

<style>
  .body {
    padding-top: 28px;
  }
</style>
