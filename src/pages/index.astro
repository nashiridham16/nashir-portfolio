---
import DevLayout from '../layouts/DevLayout.astro';
import L from '../components/L.astro';
import Icon from '../components/Icon.astro';
import { site, contacts } from '../data/site';
import {
  hero,
  clientFlags,
  clientsTitle,
  skillIcons,
  toolIcons,
  clients,
  about,
  stats,
  work,
  experienceTitle,
  experienceHint,
  currentLabel,
  experience,
  educationTitle,
  education,
  orgTitle,
  organizations,
  stack,
  quote,
  contact,
} from '../data/home';

// Judul hero dipecah per kata agar bisa dianimasikan satu per satu
const words = (s: string) =>
  s
    .split(' ')
    .map((w, i) => `<span class="w"><span style="--i:${i}">${w}</span></span>`)
    .join(' ');
const heroTitle = { en: words(hero.title.en), id: words(hero.title.id) };

const external = (href: string) => !href.startsWith('mailto');
---

<DevLayout>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="status">
          <span class="pulse" aria-hidden="true"></span>
          <L t={hero.status} />
        </p>

        <L as="h1" class="hero-title" t={heroTitle} />

        <L as="p" class="hero-lead" t={hero.lead} />

        <div class="hero-cta">
          <a href={site.whatsapp} class="btn btn-primary" target="_blank" rel="noopener">
            <Icon name="whatsapp" size={18} />
            <L t={hero.ctaPrimary} />
          </a>
          <a href={site.cv} class="btn btn-ghost" target="_blank" rel="noopener" data-cursor="cv">
            <Icon name="download" size={18} />
            <L t={hero.ctaSecondary} />
          </a>
        </div>

        <div class="trust">
          <ul class="trust-flags">
            {clientFlags.map((f) => (
              <li>
                <img src={f.image} alt={f.name.en} title={f.name.en} width="40" height="40" />
              </li>
            ))}
          </ul>
          <div>
            <L as="strong" t={hero.trust} />
            <L as="span" t={hero.trustSub} />
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <figure class="win preview">
          <figcaption class="win-bar">
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="url">idham-nashir.dev</span>
          </figcaption>
          <img src="/images/profile-photo.png" alt="Portrait of Idham Ahmad Nashir" width="1200" height="1200" fetchpriority="high" />
        </figure>

        <div class="win editor" aria-label="Developer profile as code">
          <div class="win-bar">
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="win-file">nashir.config.ts</span>
          </div>
          <pre class="code"><code><span class="ln" style="--l:0"><span class="k">const</span> <span class="v">developer</span> = {'{'}</span>
<span class="ln" style="--l:1">  <span class="p">name</span>: <span class="s">'Idham Ahmad Nashir'</span>,</span>
<span class="ln" style="--l:2">  <span class="p">role</span>: [<span class="s">'Front-End'</span>, <span class="s">'SEO'</span>, <span class="s">'Ads'</span>, <span class="s">'Design'</span>],</span>
<span class="ln" style="--l:3">  <span class="p">based</span>: <span class="s">'Malang, ID'</span>,</span>
<span class="ln" style="--l:4">  <span class="p">clients</span>: <span class="n">79</span>,</span>
<span class="ln" style="--l:5">  <span class="p">available</span>: <span class="k">true</span>, <L class="c" t={hero.codeComment} /></span>
<span class="ln" style="--l:6">{'}'};<span class="caret" aria-hidden="true"></span></span></code></pre>
        </div>

        <p class="chip chip-a"><Icon name="trend" size={16} /><L t={hero.chipRevenue} /></p>
        <p class="chip chip-b"><Icon name="chart" size={16} /><L t={hero.chipSeo} /></p>
      </div>
    </div>

    <div class="clients">
      <div class="wrap">
        <L as="p" class="clients-title" t={clientsTitle} />
      </div>
      <div class="marquee">
        <ul class="marquee-track">
          {[...clients, ...clients].map((c, i) => (
            <li aria-hidden={i >= clients.length ? 'true' : undefined}>
              <img src={c.logo} alt="" width="36" height="36" loading="lazy" />
              <span>{c.name}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= ABOUT ================= -->
  <section class="sec" id="about">
    <div class="wrap about-grid">
      <article class="win rise">
        <div class="win-bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="win-file">about.md</span>
        </div>
        <div class="win-body about-body">
          <L as="h2" class="sec-title" t={about.title} />
          {about.paragraphs.map((p) => <L as="p" t={p} />)}
          <dl class="facts">
            {about.facts.map((f) => (
              <div>
                <dt>{f.key}</dt>
                <L as="dd" t={f.value} />
              </div>
            ))}
          </dl>
        </div>
      </article>

      <aside class="win term rise" style="--d:.12s" aria-label="Stats">
        <div class="win-bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="win-file">zsh</span>
        </div>
        <div class="win-body">
          <p class="cmd"><span class="prompt">~ $</span> nashir --stats</p>
          <ul class="stats">
            {stats.map((s) => (
              <li>
                <strong><span data-count={s.value}>{s.value}</span>+</strong>
                <L t={s.label} />
              </li>
            ))}
          </ul>
          <p class="ok"><Icon name="leaf" size={14} /> <L t={hero.trust} /></p>
          <p class="cmd"><span class="prompt">~ $</span> <span class="caret" aria-hidden="true"></span></p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ================= WORK ================= -->
  <section class="sec" id="work">
    <div class="wrap">
      <header class="sec-head">
        <span class="sec-path">~/work</span>
        <L as="h2" class="sec-title" t={work.title} />
        <L as="p" class="sec-lead" t={work.lead} />
      </header>

      <ul class="bento">
        {work.items.map((w, i) => (
          <li class={`rise b-${i}`} style={`--d:${i * 0.08}s`}>
            <a href={w.href} class="win work-card" data-cursor="view">
              <span class="win-bar">
                <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="win-file">{w.file}/</span>
              </span>
              <span class="work-shot">
                <img src={w.image} alt="" loading="lazy" />
              </span>
              <span class="work-body">
                <L as="h3" t={w.title} />
                <L as="span" class="work-text" t={w.text} />
                <span class="work-link"><L t={work.view} /> <Icon name="arrow" size={16} /></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= EXPERIENCE ================= -->
  <section class="sec" id="experience">
    <div class="wrap">
      <header class="sec-head">
        <span class="sec-path">~/experience</span>
        <L as="h2" class="sec-title" t={experienceTitle} />
        <L as="p" class="sec-lead" t={experienceHint} />
      </header>

      <div class="win rise">
        <div class="win-bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="win-file">git log --graph</span>
        </div>
        <ol class="log">
          {experience.map((job, i) => (
            <li>
              <details open={i === 0}>
                <summary>
                  <span class="node" aria-hidden="true"></span>
                  <span class="hash">{job.hash}</span>
                  <img class="log-logo" src={job.logo} alt="" width="32" height="32" loading="lazy" />
                  <span class="log-main">
                    <strong><L t={job.role} /> <span class="at">@</span> {job.company}</strong>
                    <L as="span" class="log-date" t={job.period} />
                  </span>
                  {job.current && <L as="span" class="head" t={currentLabel} />}
                  <span class="toggle" aria-hidden="true">+</span>
                </summary>
                <ul class="log-points">
                  {job.points.map((p) => <L as="li" t={p} />)}
                </ul>
              </details>
            </li>
          ))}
        </ol>
      </div>

      <div class="two">
        <section class="win rise" aria-labelledby="edu-title">
          <div class="win-bar">
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="win-file">education/</span>
          </div>
          <div class="win-body">
            <L as="h3" id="edu-title" class="panel-title" t={educationTitle} />
            <ul class="tree">
              {education.map((e) => (
                <li>
                  <img src={e.logo} alt="" width="40" height="40" loading="lazy" />
                  <span>
                    <strong>{e.school}</strong>
                    <L as="span" class="tree-sub" t={e.major} />
                    <L as="span" class="tree-date" t={e.period} />
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section class="win rise" style="--d:.1s" aria-labelledby="org-title">
          <div class="win-bar">
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="win-file">organizations/</span>
          </div>
          <div class="win-body">
            <L as="h3" id="org-title" class="panel-title" t={orgTitle} />
            <ul class="orgs">
              {organizations.map((o) => (
                <li>
                  <img src={o.logo} alt="" width="36" height="36" loading="lazy" />
                  <span>
                    <strong>{o.name}</strong>
                    <span class="tree-sub"><L t={o.role} />, {o.period}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      </div>
    </div>
  </section>

  <!-- ================= STACK ================= -->
  <section class="sec" id="stack">
    <div class="wrap">
      <header class="sec-head">
        <span class="sec-path">~/stack</span>
        <L as="h2" class="sec-title" t={stack.title} />
        <L as="p" class="sec-lead" t={stack.lead} />
      </header>

      <div class="stack-grid">
        <div class="win rise">
          <div class="win-bar">
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="win-file">package.json</span>
          </div>
          <div class="win-body">
            <L as="h3" class="panel-title" t={stack.skillsLabel} />
            <ul class="dock">
              {skillIcons.map((s) => (
                <li class="tile">
                  <span class="tile-icon">{s.icon ? <Icon name={`si:${s.icon}`} size={34} /> : <span class="mark">{s.mark}</span>}</span>
                  <span class="tile-label">{s.label}</span>
                </li>
              ))}
            </ul>
            <L as="h3" class="panel-title tools-title" t={stack.toolsLabel} />
            <ul class="dock dock-tools">
              {toolIcons.map((t) => (
                <li class="tile">
                  <span class="tile-icon">{t.icon ? <Icon name={`si:${t.icon}`} size={30} /> : <span class="mark">{t.mark}</span>}</span>
                  <span class="tile-label">{t.label}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="side-col">
          <div class="win rise" style="--d:.1s">
            <div class="win-bar">
              <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="win-file">soft-skills.log</span>
            </div>
            <div class="win-body">
              <L as="h3" class="panel-title" t={stack.softLabel} />
              <ul class="bars">
                {stack.soft.map((s) => (
                  <li>
                    <L t={s.label} />
                    <span class="bar" role="img" aria-label={`${s.value}%`}><span style={`--v:${s.value}%`}></span></span>
                    <span class="pct">{s.value}%</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <figure class="win quote rise" style="--d:.18s">
            <div class="win-body">
              <pre class="q-open" aria-hidden="true">/**</pre>
              <L as="blockquote" t={quote.text} />
              <figcaption>{quote.author}</figcaption>
              <pre class="q-close" aria-hidden="true"> */</pre>
              <a href={site.twitter} target="_blank" rel="noopener" class="q-more">
                <Icon name="twitter" size={14} /> <L t={quote.more} />
              </a>
            </div>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CONTACT ================= -->
  <section class="sec" id="contact">
    <div class="wrap">
      <div class="win contact rise">
        <div class="win-bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="win-file">contact.sh</span>
        </div>
        <div class="contact-grid">
          <div class="contact-copy">
            <p class="status">
              <span class="pulse" aria-hidden="true"></span>
              <L t={hero.status} />
            </p>
            <L as="h2" class="contact-title" t={contact.title} />
            <L as="p" class="sec-lead" t={contact.lead} />
            <div class="hero-cta">
              <a href={site.whatsapp} class="btn btn-primary" target="_blank" rel="noopener">
                <Icon name="whatsapp" size={18} /> <L t={contact.whatsapp} />
              </a>
              <a href="mailto:ahmadnashir135@gmail.com" class="btn btn-ghost">
                <Icon name="mail" size={18} /> <L t={contact.email} />
              </a>
            </div>
          </div>
          <ul class="channels">
            {contacts.map((c) => (
              <li>
                <a href={c.href} target={external(c.href) ? '_blank' : undefined} rel="noopener">
                  <span class="ch-icon"><Icon name={c.icon} size={18} /></span>
                  <span class="ch-name">{c.icon}</span>
                  <span class="ch-val">{c.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</DevLayout>

<script>
  // Angka statistik menghitung naik saat terlihat
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        io.unobserve(el);
        const to = Number(el.dataset.count);
        const t0 = performance.now();
        const step = (now: number) => {
          const p = Math.min((now - t0) / 1300, 1);
          el.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }),
    { threshold: 0.5 },
  );
  if (!reduce) nums.forEach((n) => io.observe(n));

  // Bar soft skill terisi saat terlihat
  const bars = document.querySelectorAll('.bars');
  const barIO = new IntersectionObserver((entries) =>
    entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add('fill');
        barIO.unobserve(e.target);
      }
    }),
  );
  bars.forEach((b) => barIO.observe(b));
</script>

<style>
  /* ================= HERO ================= */
  .hero {
    padding-top: 40px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
    min-height: calc(100svh - 230px);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(157, 255, 32, 0.06);
    font-family: var(--mono);
    font-size: 13px;
    color: var(--green-2);
    animation: up 0.7s var(--ease) 0.15s both;
  }
  .hero-title {
    margin-top: 26px;
    font-size: clamp(42px, 5.6vw, 76px);
    font-weight: 750;
    font-variation-settings: 'wdth' 90;
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .hero-title :global(.w) {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .hero-title :global(.w > span) {
    display: inline-block;
    animation: word 0.9s var(--ease) both;
    animation-delay: calc(0.3s + var(--i) * 0.055s);
  }
  .hero-lead {
    margin-top: 26px;
    max-width: 56ch;
    color: var(--muted);
    font-size: 18px;
    animation: up 0.8s var(--ease) 0.85s both;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
    animation: up 0.8s var(--ease) 1s both;
  }
  .trust {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
    animation: up 0.8s var(--ease) 1.15s both;
  }
  .trust-flags {
    display: flex;
    flex-shrink: 0;
  }
  .trust-flags li {
    width: 40px;
    height: 40px;
    margin-left: -10px;
    border-radius: 50%;
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 1px var(--line);
    overflow: hidden;
    transition: transform 0.25s var(--ease);
  }
  .trust-flags li:first-child {
    margin-left: 0;
  }
  .trust-flags li:hover {
    transform: translateY(-4px);
    z-index: 1;
  }
  .trust-flags img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .trust strong {
    display: block;
    font-size: 16px;
  }
  .trust span {
    font-size: 14px;
    color: var(--muted);
  }

  /* --- komposisi visual: preview foto + editor kode --- */
  .hero-visual {
    position: relative;
    padding: 0 0 120px 40px;
  }
  .preview {
    width: 82%;
    margin-left: auto;
    animation: pop 1s var(--ease) 0.45s both;
  }
  .preview img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: radial-gradient(circle at 50% 60%, rgba(157, 255, 32, 0.12), transparent 70%);
  }
  .url {
    flex: 1;
    padding: 4px 12px;
    border-radius: 8px;
    background: rgba(2, 5, 3, 0.5);
    color: var(--muted);
  }
  .editor {
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(440px, 88%);
    background: var(--glass-strong);
    animation: pop 1s var(--ease) 0.7s both;
  }
  .code {
    margin: 0;
    padding: 18px 20px 20px;
    font-family: var(--mono);
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--ink);
    white-space: pre;
    overflow-x: auto;
    counter-reset: line;
  }
  .ln {
    display: inline-block;
    counter-increment: line;
    clip-path: inset(0 100% 0 0);
    animation: type 0.5s steps(24, end) both;
    animation-delay: calc(1.1s + var(--l) * 0.22s);
  }
  .ln::before {
    content: counter(line);
    display: inline-block;
    width: 2ch;
    margin-right: 16px;
    color: var(--faint);
    text-align: right;
  }
  .k {
    color: var(--cyan);
  }
  .v {
    color: var(--ink);
  }
  .p {
    color: var(--pink);
  }
  .s {
    color: var(--green);
  }
  .n {
    color: var(--amber);
  }
  .code :global(.c) {
    color: var(--faint);
    font-style: italic;
  }
  .caret {
    display: inline-block;
    width: 8px;
    height: 1.1em;
    margin-left: 4px;
    vertical-align: -0.15em;
    background: var(--green);
    box-shadow: 0 0 10px var(--green);
    animation: blink 1s steps(1) infinite;
  }
  .chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--glass-strong);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    box-shadow: 0 16px 40px -20px #000;
  }
  .chip :global(.icon) {
    color: var(--green);
  }
  .chip-a {
    top: 18%;
    left: 0;
    max-width: 290px;
    line-height: 1.35;
    animation: pop 0.8s var(--ease) 2.7s both, float 6s ease-in-out 3.5s infinite;
  }
  .chip-b {
    right: 4%;
    top: -28px;

    animation: pop 0.8s var(--ease) 2.9s both, float 7s ease-in-out 3.7s infinite reverse;
  }

  /* --- logo klien berjalan --- */
  .clients {
    margin-top: 64px;
    animation: up 0.8s var(--ease) 1.3s both;
  }
  .clients-title {
    font-size: 15px;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line-soft);
    background: rgba(2, 5, 3, 0.4);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee-track {
    display: flex;
    gap: 48px;
    width: max-content;
    padding: 20px 0;
    animation: slide 40s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  .marquee-track li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    font-size: 17px;
    color: var(--muted);
    white-space: nowrap;
  }
  .marquee-track img {
    width: 36px;
    height: 36px;
    padding: 4px;
    object-fit: contain;
    border-radius: 10px;
    background: #f4f7f5;
  }

  /* ================= ABOUT ================= */
  .about-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: 24px;
