---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Halaman tidak ditemukan">
  <section class="nf">
    <div class="container">
      <p class="code">404</p>
      <h1>Halaman tidak ditemukan</h1>
      <p>Halaman yang Anda cari tidak ada atau sudah dipindahkan.</p>
      <a href="/" class="btn">Kembali ke Home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 60vh;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 60px 0;
  }
  .code {
    font-size: clamp(80px, 18vw, 160px);
    font-weight: 700;
    line-height: 1;
    color: var(--green);
    text-shadow: 0 0 30px rgba(157, 255, 32, 0.4);
  }
  h1 {
    font-size: 26px;
    margin: 10px 0;
  }
  p {
    color: #bbb;
    margin-bottom: 26px;
  }
</style>
