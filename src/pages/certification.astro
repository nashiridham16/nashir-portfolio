---
import DevLayout from '../layouts/DevLayout.astro';
import PageHead from '../components/PageHead.astro';
import DevGallery from '../components/DevGallery.astro';
import CtaBand from '../components/CtaBand.astro';
import L from '../components/L.astro';
import { certificateGallery } from '../data/site';
import { certPage, certifications, certListTitle, certGalleryTitle, galleryLabels } from '../data/pages';
---

<DevLayout title={certPage.metaTitle} description={certPage.metaDescription}>
  <PageHead page={certPage} />

  <section class="wrap sec-block">
    <div class="win rise">
      <div class="win-bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="win-file">certifications.json</span>
      </div>
      <div class="list-body">
        <L as="h2" class="block-title" t={certListTitle} />
        <ol class="certs">
          {certifications.map((c) => (
            <li>
              <span class="c-name">{c.name}</span>
              <span class="c-issuer">{c.issuer}</span>
              <L as="span" class="c-date" t={c.date} />
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="wrap sec-block">
    <L as="h2" class="block-title outside" t={certGalleryTitle} />
    <DevGallery items={certificateGallery} label={galleryLabels.cert} columns={3} mobileColumns={1} />
  </section>

  <CtaBand />
</DevLayout>

<style>
  .sec-block {
    margin-top: 90px;
  }
  .list-body {
    padding: 28px;
  }
  .block-title {
    font-size: clamp(26px, 3vw, 34px);
    margin-bottom: 20px;
  }
  .outside {
    margin-bottom: 24px;
  }
  .certs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 32px;
  }
  .certs li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .c-name {
    font-weight: 600;
    font-size: 16.5px;
  }
  .c-issuer {
    grid-column: 1;
    font-size: 14px;
    color: var(--muted);
  }
  .certs :global(.c-date) {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--green);
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    .sec-block {
      margin-top: 64px;
    }
    .list-body {
      padding: 20px;
    }
    .certs {
      grid-template-columns: 1fr;
    }
  }
</style>
