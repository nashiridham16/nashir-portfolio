---
import DevLayout from '../layouts/DevLayout.astro';
import PageHead from '../components/PageHead.astro';
import WorkTabs from '../components/WorkTabs.astro';
import DevGallery from '../components/DevGallery.astro';
import CtaBand from '../components/CtaBand.astro';
import { designGallery } from '../data/site';
import { designPage, galleryLabels } from '../data/pages';
---

<DevLayout title={designPage.metaTitle} description={designPage.metaDescription}>
  <PageHead page={designPage} />
  <WorkTabs />
  <section class="wrap body">
    <DevGallery items={designGallery} label={galleryLabels.design} columns={4} mobileColumns={2} />
  </section>
  <CtaBand />
</DevLayout>

<style>
  .body {
    padding-top: 28px;
  }
</style>
